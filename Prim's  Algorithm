def prim(graph, n):
    selected = [False] * n
    selected[0] = True

    total = 0

    print("\nEdge \tWeight")

    for _ in range(n - 1):
        minimum = float('inf')
        x = y = 0

        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x = i
                            y = j

        print(x, "-", y, "\t", graph[x][y])
        total += graph[x][y]
        selected[y] = True

    print("Minimum Cost =", total)


